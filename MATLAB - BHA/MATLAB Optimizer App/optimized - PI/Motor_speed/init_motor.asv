function init_motor()

R = 2.18;          % Ohm
L = 2.3e-3;        % H
K = 0.0112;        % N.m/A  (also V.s/rad)
b = 1.4e-6;        % N.m.s/rad
J = 2.24e-8;       % kg.m^2   % rough shaft-based estimate only
N = 131.25;        % gear ratio

step_amp = 1;

num = K;
den = [(J*L) ((J*R)+(L*b)) ((b*R)+K^2)];

assignin('base','num',num);
assignin('base','den',den);
assignin('base','step_amp',step_amp);

end