function [Ku, Tu] = estimateUltimateGain(model)
% تقدير Ku و Tu بدون استخدام Signal Processing Toolbox
Kp = 1;
Ki = 0;
Kd = 0;
assignin('base','kp',Kp);
assignin('base','ki',Ki);
assignin('base','kd',Kd);

maxIter = 50;
dt = 1; % زيادة Kp لكل محاولة
Ku = NaN;
Tu = NaN;

for k = 1:maxIter
    assignin('base','kp',Kp);
    simOut = sim(model,'StopTime','10');
    y = simOut.OutputResponse.Data;
    t = simOut.OutputResponse.Time;
    
    % حساب اختلاف الإشارة بين النقاط المتتالية
    dy = diff(y);
    
    % عدّ عدد المرات التي تتغير فيها الإشارة (approx peaks)
    zeroCrossings = sum(dy(1:end-1).*dy(2:end) < 0);
    
    if zeroCrossings >= 6 % إذا فيه تذبذب واضح
        Ku = Kp;
        % حساب Tu تقريبا من متوسط المسافة بين التغيرات
        crossingTimes = t([false; dy(1:end-1).*dy(2:end) < 0]);
        Tu = mean(diff(crossingTimes))*2; % *2 لأن نصف دورة فقط
        return
    end
    
    Kp = Kp + dt;
end

warning('لم يتم العثور على اهتزاز مستمر. استخدم Ku و Tu يدويًا.');
Ku = Kp;
Tu = 1;
end